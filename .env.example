# ==============================================================================
# Vaani - AI Calling ERP Configuration
# ==============================================================================

# Core Database Configuration
# PostgreSQL connection string (default uses local port 4200 on Windows setup)
DATABASE_URL=postgresql://postgres@localhost:4200/vaanidb

# Server Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=vaani_dev_jwt_secret_change_in_production_min32chars
CORS_ORIGIN=http://localhost:3000

# Timezone Setting (default business operations timezone)
DEFAULT_TIMEZONE=Asia/Kolkata

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
# Active AI Mode: "mock" (recommended for rapid development/testing) or "real" (requires model weights/GPU)
AI_MODE=mock

# Speech Recognition (ASR) Configuration
ASR_PROVIDER=indic-conformer
ASR_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual

# LLM Agent Configuration
LLM_PROVIDER=qwen
LLM_MODEL_ID=Qwen/Qwen3-8B

# Speech Synthesis (TTS) Configuration
TTS_PROVIDER=indic-parler
TTS_MODEL_ID=ai4bharat/indic-parler-tts

# Telephony Configuration (Optional for real provider testing; simulator runs by default)
TELEPHONY_PROVIDER=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=

# Voice Recording & Compliance (Strictly OFF by default)
ENABLE_CALL_RECORDING=false
CALL_RECORDING_RETENTION_DAYS=30
