{
  "name": "vaani-root",
  "version": "1.0.0",
  "private": true,
  "description": "Vaani - AI Calling ERP with Voice Agent Studio",
  "workspaces": [
    "packages/backend",
    "packages/frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=@vaani/backend",
    "dev:frontend": "npm run dev --workspace=@vaani/frontend",
    "dev:ai": "cd packages/ai-service && python main.py",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace=@vaani/backend",
    "lint": "npm run lint --workspaces",
    "db:push": "npx prisma db push --schema=packages/backend/prisma/schema.prisma",
    "db:seed": "npx tsx packages/backend/prisma/seed.ts",
    "tunnel": "node scripts/tunnel.js"
  },
  "devDependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "concurrently": "^9.1.2"
  }
}
